# =============================================================================
# AI Multifamily Deep Research Engine - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# For n8n: Set these in Settings → Variables or as system environment variables
# =============================================================================

# -----------------------------------------------------------------------------
# PERPLEXITY API (Research Engine)
# -----------------------------------------------------------------------------
# Get your API key at: https://www.perplexity.ai/settings/api
# Used for: Live demographic research with citations
# Rate limits: Free tier = 100 requests/hour
PERPLEXITY_API_KEY=xxx

# -----------------------------------------------------------------------------
# GOOGLE CLOUD / VERTEX AI (Logic Engine)
# -----------------------------------------------------------------------------
# Setup: GCP Console → APIs & Services → Credentials
# Enable: Vertex AI API, Google Drive API
# Used for: Gemini model for 30-point criteria evaluation

# Your GCP Project ID
GOOGLE_CLOUD_PROJECT=xxx

# Path to service account JSON (for local dev)
# In n8n Cloud, use OAuth2 credentials instead
GOOGLE_APPLICATION_CREDENTIALS=xxx

# Optional: Gemini API Key (alternative to Vertex AI)
# Get at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=xxx

# -----------------------------------------------------------------------------
# GOOGLE DRIVE (Criteria PDFs Storage)
# -----------------------------------------------------------------------------
# Upload your "Immutable Laws" PDFs to Google Drive
# Get File ID from share URL: https://drive.google.com/file/d/{FILE_ID}/view

# MSA Criteria PDF (16 macro-level criteria)
MSA_CRITERIA_FILE_ID=xxx

# Sub-Market Criteria PDF (14 micro-level criteria)
SUBMARKET_CRITERIA_FILE_ID=xxx

# -----------------------------------------------------------------------------
# PDF GENERATION (PDF Noodle)
# -----------------------------------------------------------------------------
# PDF Noodle API for HTML-to-PDF conversion
# Get your API key at: https://pdfnoodle.com
PDFNOODLE_API_KEY=xxx

# -----------------------------------------------------------------------------
# n8n WORKFLOW ENDPOINT
# -----------------------------------------------------------------------------
# Your n8n webhook URL for the analyze-property endpoint
# Test mode: https://your-n8n.com/webhook-test/analyze-property
# Production: https://your-n8n.com/webhook/analyze-property
N8N_WEBHOOK_URL=https://n8n.flowbaby.net/webhook/analyze-property

# Execution timeout (default: 300000ms = 5 minutes)
# N8N_EXECUTION_TIMEOUT=300000

# Queue mode for concurrent executions
# EXECUTIONS_MODE=queue

# -----------------------------------------------------------------------------
# OPTIONAL: CLOUD STORAGE (Production)
# -----------------------------------------------------------------------------
# For storing generated PDFs in cloud storage instead of local filesystem

# Google Cloud Storage bucket name
# GCS_BUCKET_NAME=mf-analyzer-pdfs

# AWS S3 (alternative)
# AWS_S3_BUCKET=mf-analyzer-pdfs
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# OPTIONAL: MONITORING (Production)
# -----------------------------------------------------------------------------
# For error tracking and performance monitoring

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/yyy

# DataDog API Key
# DD_API_KEY=...

# =============================================================================
# SETUP CHECKLIST
# =============================================================================
# [ ] 1. Copy this file: cp .env.example .env
# [ ] 2. Get Perplexity API key and add it
# [ ] 3. Create GCP project and enable APIs (Vertex AI, Drive)
# [ ] 4. Create service account or OAuth2 credentials
# [ ] 5. Upload criteria PDFs to Google Drive and get File IDs
# [ ] 6. Start PDF service: cd pdf-service && uvicorn app.main:app --port 8000
# [ ] 7. Set environment variables in n8n (Settings → Variables)
# [ ] 8. Import workflow: n8n/workflows/main-workflow.json
# [ ] 9. Configure credentials in n8n UI
# [ ] 10. Activate workflow and test!
# =============================================================================
