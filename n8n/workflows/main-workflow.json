      "id": "load-research-prompt-template",
      "name": "Load Research Prompt Template",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [650, 100]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gemini-2.0-flash-exp",
          "mode": "list",
          "cachedResultName": "Gemini 2.0 Flash"
        },
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "={{ $loadFile('/prompts/gemini-system-prompt.txt') }}"
            },
            {
              "role": "user",
              "content": "=IMMUTABLE LAWS CONTEXT:\n{{ $node['Parse Criteria PDFs'].json.combined_secret_sauce }}\n\nRESEARCH DATA:\n{{ $node['Perplexity Research Agent'].json.choices[0].message.content }}\n\nUSER CONTEXT DOCUMENTS:\n{{ JSON.stringify($node['Parse User Context Docs'].json.context_documents) }}\n\nTASK: Evaluate the property at {{ $('Extract Input Data').item.json.address }} against ALL 30 criteria. Return ONLY the JSON array with exactly 30 objects."
            }
          ]
        },
        "options": {
          "temperature": 0.1,
          "maxTokens": 8000
        }
      },
      "id": "gemini-logic-engine",
      "name": "Gemini Logic Engine",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleVertex",
      "typeVersion": 1,
      "position": [1250, 300],
      "credentials": {
        "googleVertexOAuth2Api": {
          "id": "google-vertex-credentials",
          "name": "Google Vertex AI Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract and validate the 30-point heat map JSON\nconst geminiResponse = $input.first().json.choices[0].message.content;\n\n// Extract JSON from response (may be wrapped in markdown code blocks)\nlet heatMapJson;\ntry {\n  const jsonMatch = geminiResponse.match(/\\[\\s*\\{[\\s\\S]*\\}\\s*\\]/);\n  if (jsonMatch) {\n    heatMapJson = JSON.parse(jsonMatch[0]);\n  } else {\n    heatMapJson = JSON.parse(geminiResponse);\n  }\n} catch (error) {\n  throw new Error(`Failed to parse Gemini response as JSON: ${error.message}`);\n}\n\n// Validation\nif (!Array.isArray(heatMapJson)) {\n  throw new Error('Heat map must be an array');\n}\n\nif (heatMapJson.length !== 30) {\n  throw new Error(`Heat map must contain exactly 30 items, got ${heatMapJson.length}`);\n}\n\n// Validate each item has required fields\nconst requiredFields = ['id', 'metric', 'threshold', 'value', 'status', 'reasoning', 'source'];\nfor (let i = 0; i < heatMapJson.length; i++) {\n  const item = heatMapJson[i];\n  for (const field of requiredFields) {\n    if (!(field in item)) {\n      throw new Error(`Item ${i} missing required field: ${field}`);\n    }\n  }\n  \n  // Validate status values\n  if (!['GREEN', 'YELLOW', 'RED'].includes(item.status)) {\n    throw new Error(`Item ${i} has invalid status: ${item.status}`);\n  }\n}\n\nreturn {\n  heat_map: heatMapJson,\n  validation_passed: true,\n  total_items: heatMapJson.length,\n  green_count: heatMapJson.filter(i => i.status === 'GREEN').length,\n  yellow_count: heatMapJson.filter(i => i.status === 'YELLOW').length,\n  red_count: heatMapJson.filter(i => i.status === 'RED').length\n};"
      },
      "id": "validate-heat-map",
      "name": "Validate Heat Map JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 300]
    },
