            },
            {
              "name": "address",
              "value": "={{ $('Extract Input Data').item.json.address }}"
            },
            {
              "name": "research_data",
              "value": "={{ $node['Perplexity Research Agent'].json }}"
            }
          ]
        },
        "options": {}
      },
      "id": "generate-pdf",
      "name": "Generate Investment Brief PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  \"status\": \"success\",\n  \"deal_name\": $('Extract Input Data').item.json.deal_name,\n  \"address\": $('Extract Input Data').item.json.address,\n  \"analysis_summary\": {\n    \"total_criteria\": $node['Validate Heat Map JSON'].json.total_items,\n    \"green_count\": $node['Validate Heat Map JSON'].json.green_count,\n    \"yellow_count\": $node['Validate Heat Map JSON'].json.yellow_count,\n    \"red_count\": $node['Validate Heat Map JSON'].json.red_count,\n    \"recommendation\": $node['Validate Heat Map JSON'].json.red_count > 5 ? 'NO-GO' : ($node['Validate Heat Map JSON'].json.red_count > 2 ? 'CAUTION' : 'PROCEED')\n  },\n  \"heat_map\": $node['Validate Heat Map JSON'].json.heat_map,\n  \"pdf_url\": $node['Generate Investment Brief PDF'].json.pdf_url,\n  \"generated_at\": $now.toISO()\n} }}",
        "options": {}
      },
