    {
      "parameters": {
        "jsCode": "// Parse PDF text from base64 binary data\nconst msaPdfData = $input.first().binary.data;\nconst submarketPdfData = $input.all()[1].binary.data;\n\n// In production, use PDF parsing library\n// For MVP, assume PDFs are pre-converted to text\nconst msaCriteria = Buffer.from(msaPdfData, 'base64').toString('utf-8');\nconst submarketCriteria = Buffer.from(submarketPdfData, 'base64').toString('utf-8');\n\nreturn {\n  msa_criteria_text: msaCriteria,\n  submarket_criteria_text: submarketCriteria,\n  combined_secret_sauce: msaCriteria + \"\\n\\n\" + submarketCriteria\n};"
      },
      "id": "parse-criteria-pdfs",
      "name": "Parse Criteria PDFs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse user-uploaded context documents\nconst contextFiles = $('Extract Input Data').item.json.context_files || [];\nconst parsedDocs = [];\n\nfor (let i = 0; i < contextFiles.length; i++) {\n  const file = contextFiles[i];\n  try {\n    // Assume files are base64-encoded PDFs or Excel\n    const fileData = Buffer.from(file.data, 'base64').toString('utf-8');\n    parsedDocs.push({\n      filename: file.name,\n      content: fileData,\n      type: file.type\n    });\n  } catch (error) {\n    console.error(`Failed to parse ${file.name}:`, error);\n  }\n}\n\nreturn {\n  context_documents: parsedDocs,\n  context_count: parsedDocs.length\n};"
      },
      "id": "parse-context-docs",
      "name": "Parse User Context Docs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.perplexity.ai/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
