            },
            {
              "name": "temperature",
              "value": "0.2"
            },
            {
              "name": "return_citations",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "perplexity-research",
      "name": "Perplexity Research Agent",
